---
import BaseLayout from '../layouts/BaseLayout.astro'
import { BASE } from '../consts'
---

<BaseLayout title="404">
  <div class="flex min-h-[60vh] flex-col items-center justify-center gap-5">
    <p class="bg-gradient-to-br from-theme to-muted bg-clip-text font-serif text-7xl font-bold text-transparent select-none">
      404
    </p>
    <p class="text-muted">页面不存在或已被移动</p>
    <a
      href={`${BASE}/`}
      class="rounded-full border border-border-soft px-5 py-2 text-theme transition-colors duration-200 hover:bg-bg-soft"
    >← 返回首页</a>
  </div>
</BaseLayout>
