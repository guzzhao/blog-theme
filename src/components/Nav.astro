---
import { SITE_TITLE, BASE } from '../consts'
import ThemeToggle from './ThemeToggle.astro'
---

<nav class="sticky top-0 z-50 border-b border-border-soft bg-bg/80 backdrop-blur-sm">
  <div class="mx-auto flex w-full max-w-3xl items-center justify-between px-6 py-4">
    <a
      href={`${BASE}/`}
      class="font-serif text-2xl font-bold tracking-wide transition-colors duration-200 hover:text-theme"
    >{SITE_TITLE}</a>
    <ThemeToggle />
  </div>
</nav>
